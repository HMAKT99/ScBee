{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/@fontsource/inter/files/inter-latin-{400,700}-normal.woff,node_modules/@fontsource/fraunces/files/fraunces-latin-{300,500}-normal.woff,node_modules/@fontsource-variable/fraunces/files/fraunces-latin-wght-{normal,italic}.woff2,node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2,node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/gallery",
      "schedule": "30 6 * * *"
    }
  ]
}
